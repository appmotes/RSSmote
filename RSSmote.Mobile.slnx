    <Project Path="src/RSSmote.App/RSSmote.App.csproj" />
    <Project Path="src/RSSmote.Mobile/RSSmote.Mobile.csproj" />
    <Project Path="src/RSSmote.Android/RSSmote.Android.csproj" />
    <Project Path="src/RSSmote.iOS/RSSmote.iOS.csproj" />
  </Folder>
</Solution>
