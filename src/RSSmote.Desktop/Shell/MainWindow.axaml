<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RSSmote.App.ViewModels"
        xmlns:v="using:RSSmote.Desktop.Views"
        xmlns:m="using:RSSmote.Core.Models"
        x:Class="RSSmote.Desktop.Shell.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="RSSmote"
        Width="1045" Height="660" MinWidth="900" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg.Sidebar}">
    <!-- macOS menu bar (D16). Single-key shortcuts are handled by the window, not by menu gestures. -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="File">
                <NativeMenu>
                    <NativeMenuItem Header="Add Feed…" Gesture="Meta+N" Command="{Binding ShowAddFeedCommand}" />
                    <NativeMenuItem Header="Import Feeds…" Command="{Binding ImportOpmlCommand}" />
                    <NativeMenuItem Header="Export Feeds…" Command="{Binding ExportOpmlCommand}" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="Refresh" Gesture="Meta+R" Command="{Binding RefreshCommand}" />
                    <NativeMenuItem Header="Mark All as Read" Gesture="Meta+Shift+A" Command="{Binding MarkAllReadCommand}" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="View">
                <NativeMenu>
                    <NativeMenuItem Header="Starred Items" Gesture="Meta+D1" Command="{Binding ShowFilterCommand}" CommandParameter="{x:Static m:StreamFilter.Starred}" />
                    <NativeMenuItem Header="Unread Items" Gesture="Meta+D2" Command="{Binding ShowFilterCommand}" CommandParameter="{x:Static m:StreamFilter.Unread}" />
                    <NativeMenuItem Header="All Items" Gesture="Meta+D3" Command="{Binding ShowFilterCommand}" CommandParameter="{x:Static m:StreamFilter.All}" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="Theme">
                        <NativeMenu>
                            <!-- Submenus exist here so the native menu exports them as submenus; code fills their items (D22, L13). -->
                            <NativeMenuItem Header="Appearance"><NativeMenu /></NativeMenuItem>
                            <NativeMenuItem Header="Light Theme"><NativeMenu /></NativeMenuItem>
                            <NativeMenuItem Header="Dark Theme"><NativeMenu /></NativeMenuItem>
                            <NativeMenuItemSeparator />
                            <NativeMenuItem Header="Grayscale Favicons" Command="{Binding Settings.ToggleGrayscaleFaviconsCommand}" />
                        </NativeMenu>
                    </NativeMenuItem>
                    <NativeMenuItem Header="Sort Unread Items">
                        <NativeMenu>
                            <NativeMenuItem Header="Newest First" Command="{Binding Settings.SetSortNewestFirstCommand}" CommandParameter="{x:True}" />
                            <NativeMenuItem Header="Oldest First" Command="{Binding Settings.SetSortNewestFirstCommand}" CommandParameter="{x:False}" />
                        </NativeMenu>
                    </NativeMenuItem>
                    <NativeMenuItem Header="Group Items">
                        <NativeMenu>
                            <NativeMenuItem Header="By Date" Command="{Binding Settings.SetGroupByDateCommand}" CommandParameter="{x:True}" />
                            <NativeMenuItem Header="None" Command="{Binding Settings.SetGroupByDateCommand}" CommandParameter="{x:False}" />
                        </NativeMenu>
                    </NativeMenuItem>
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="Filter…" Gesture="Meta+F" Command="{Binding FocusSearchCommand}" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="Article">
                <NativeMenu>
                    <NativeMenuItem Header="Next Article  (J)" Command="{Binding NextArticleCommand}" />
                    <NativeMenuItem Header="Previous Article  (K)" Command="{Binding PreviousArticleCommand}" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="Toggle Read  (M)" Command="{Binding ToggleReadCommand}" />
                    <NativeMenuItem Header="Toggle Starred  (S)" Command="{Binding ToggleStarredCommand}" />
                    <NativeMenuItem Header="Open in Browser  (B)" Command="{Binding OpenInBrowserCommand}" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="Next Feed  (N)" Command="{Binding NextFeedCommand}" />
                    <NativeMenuItem Header="Previous Feed  (P)" Command="{Binding PreviousFeedCommand}" />
                </NativeMenu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <v:ShellView />
</Window>
