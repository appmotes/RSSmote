<!-- The article card (D9, D14): path and actions in the strip, the page, shortcut hints in the status bar. -->
<!-- The card is flush with the view's left edge; its ring and shadow are drawn outside the view (L14). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="urn:RSSmote.App.Controls"
             xmlns:vm="using:RSSmote.App.ViewModels"
             xmlns:v="using:RSSmote.Desktop.Views"
             x:Class="RSSmote.Desktop.Views.ArticleView"
             x:DataType="vm:ShellViewModel"
             ClipToBounds="False">
    <Border Classes="card" Background="{DynamicResource Brush.Bg.Article}">
        <Border Classes="cardClip">
            <DockPanel>
                <c:TitleStrip DockPanel.Dock="Top" Classes="card" Padding="{x:Static v:Chrome.ArticleStripPadding}"
                              BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Line.Separator}">
                    <c:TitleStrip.Leading>
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding Article.HasArticle}">
                            <Button Classes="icon" ToolTip.Tip="Close Article (.)" Command="{Binding GoBackCommand}">
                                <c:Icon Data="{StaticResource Icon.X}" />
                            </Button>
                            <StackPanel Orientation="Horizontal" Spacing="7" Margin="4,0,0,0">
                                <c:Favicon Size="{StaticResource Size.Favicon}" VerticalAlignment="Center"
                                           Source="{Binding Article.Favicon}" Title="{Binding Article.FeedTitle}"
                                           IsGrayscale="{Binding Article.IsFaviconGrayscale}"
                                           TileBrush="{DynamicResource Brush.Bg.FaviconTile}"
                                           LetterBrush="{DynamicResource Brush.Ink.OnTile}" />
                                <TextBlock Classes="crumb" Text="{Binding Article.FeedTitle}" MaxWidth="220"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="crumb" Text="›" />
                                <TextBlock Classes="crumb" Text="{Binding Article.PositionText}" FontFeatures="+tnum" />
                            </StackPanel>
                        </StackPanel>
                    </c:TitleStrip.Leading>
                    <c:TitleStrip.Trailing>
                        <StackPanel Orientation="Horizontal" IsEnabled="{Binding Article.HasArticle}">
                            <Button Classes="icon" ToolTip.Tip="Toggle Read (M)" Command="{Binding ToggleReadCommand}">
                                <c:Icon Data="{StaticResource Icon.Circle}" Size="14" IsFilled="{Binding Article.IsUnread}" />
                            </Button>
                            <Button Classes="icon" ToolTip.Tip="Toggle Starred (S)" Command="{Binding ToggleStarredCommand}">
                                <c:Icon Data="{StaticResource Icon.Star}" IsFilled="{Binding Article.IsStarred}" />
                            </Button>
                            <Button Classes="icon" ToolTip.Tip="Open in Browser (B)" Command="{Binding OpenInBrowserCommand}">
                                <c:Icon Data="{StaticResource Icon.Globe}" />
                            </Button>
                        </StackPanel>
                    </c:TitleStrip.Trailing>
                </c:TitleStrip>

                <!-- The page sits between the strip and this bar, so the card's corners stay drawn by Avalonia (D20). -->
                <c:StatusBar DockPanel.Dock="Bottom" IsVisible="{Binding Article.HasArticle}">
                    <c:StatusBar.Leading>
                        <!-- One row tall and clipped: hints that do not fit wrap out of sight whole. -->
                        <WrapPanel ItemSpacing="16" Height="18" ClipToBounds="True">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Border Classes="kbd"><TextBlock Classes="kbd" Text="j" /></Border>
                                <Border Classes="kbd"><TextBlock Classes="kbd" Text="k" /></Border>
                                <TextBlock Text="next / previous" VerticalAlignment="Center" Margin="2,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Classes="kbd"><TextBlock Classes="kbd" Text="space" /></Border>
                                <TextBlock Text="scroll" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Classes="kbd"><TextBlock Classes="kbd" Text="s" /></Border>
                                <TextBlock Text="star" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Classes="kbd"><TextBlock Classes="kbd" Text="m" /></Border>
                                <TextBlock Text="read" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Classes="kbd"><TextBlock Classes="kbd" Text="b" /></Border>
                                <TextBlock Text="browser" VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>
                    </c:StatusBar.Leading>
                    <c:StatusBar.Trailing>
                        <Button Classes="icon" ToolTip.Tip="Next Article (J)" Command="{Binding NextArticleCommand}">
                            <c:Icon Data="{StaticResource Icon.ChevronDown}" />
                        </Button>
                    </c:StatusBar.Trailing>
                </c:StatusBar>

                <Panel>
                    <c:EmptyState Title="{Binding Article.EmptyTitle}" Subtitle="{Binding Article.EmptySubtitle}"
                                  IsVisible="{Binding !Article.HasArticle}">
                        <c:EmptyState.Shortcuts>
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                  ColumnSpacing="12" RowSpacing="7">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Border Classes="kbd"><TextBlock Classes="kbd" Text="j" /></Border>
                                    <Border Classes="kbd"><TextBlock Classes="kbd" Text="k" /></Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Classes="body" Text="Next / previous article" VerticalAlignment="Center" />
                                <Border Grid.Row="1" Classes="kbd" HorizontalAlignment="Left"><TextBlock Classes="kbd" Text="space" /></Border>
                                <TextBlock Grid.Row="1" Grid.Column="1" Classes="body" Text="Scroll, then next article" VerticalAlignment="Center" />
                                <Border Grid.Row="2" Classes="kbd" HorizontalAlignment="Left"><TextBlock Classes="kbd" Text="s" /></Border>
                                <TextBlock Grid.Row="2" Grid.Column="1" Classes="body" Text="Star" VerticalAlignment="Center" />
                                <Border Grid.Row="3" Classes="kbd" HorizontalAlignment="Left"><TextBlock Classes="kbd" Text="m" /></Border>
                                <TextBlock Grid.Row="3" Grid.Column="1" Classes="body" Text="Mark read / unread" VerticalAlignment="Center" />
                                <Border Grid.Row="4" Classes="kbd" HorizontalAlignment="Left"><TextBlock Classes="kbd" Text="b" /></Border>
                                <TextBlock Grid.Row="4" Grid.Column="1" Classes="body" Text="Open in browser" VerticalAlignment="Center" />
                                <Border Grid.Row="5" Classes="kbd" HorizontalAlignment="Left">
                                    <TextBlock Classes="kbd" Text="{x:Static v:Chrome.AddFeedShortcut}" />
                                </Border>
                                <TextBlock Grid.Row="5" Grid.Column="1" Classes="body" Text="Add Feed" VerticalAlignment="Center" />
                            </Grid>
                        </c:EmptyState.Shortcuts>
                    </c:EmptyState>
                    <c:ArticleHost x:Name="Host" IsVisible="{Binding Article.HasArticle}"
                                   Document="{Binding Article.Document}"
                                   ArticleFont="{Binding Article.Font}"
                                   ArticleFontSize="{Binding Article.FontSize}"
                                   IsObscured="{Binding IsPanelOpen}"
                                   LinkClicked="OnLinkClicked" />
                </Panel>
            </DockPanel>
        </Border>
    </Border>
</UserControl>
