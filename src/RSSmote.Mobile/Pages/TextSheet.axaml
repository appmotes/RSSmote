<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RSSmote.App.ViewModels"
             xmlns:v="using:RSSmote.Mobile.Views"
             x:Class="RSSmote.Mobile.Pages.TextSheet"
             x:DataType="vm:SettingsViewModel"
             AutomaticallyApplySafeAreaPadding="False"
             Background="{DynamicResource Brush.Scrim}"
             NavigationPage.HasNavigationBar="False">
    <!-- Aa (M4, D26): text size, font, and Automatic / Light / Dark, the same setting as Appearance. -->
    <ContentPage.Resources>
        <DataTemplate x:Key="Segment" x:DataType="vm:ChoiceViewModel">
            <Button Classes="phoneSegment" Classes.on="{Binding IsChecked}" Content="{Binding Header}"
                    Command="{Binding Command}" CommandParameter="{Binding Key}" />
        </DataTemplate>
    </ContentPage.Resources>
    <Panel>
        <Button Classes="phoneScrim" Click="OnScrimClick" />
        <Border Classes="phoneSheet"
                Padding="{Binding $parent[ContentPage].SafeAreaPadding, Converter={x:Static v:PhoneConverters.BottomInset}}">
            <StackPanel Margin="20,20,20,16">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="phonePageTitle" Text="Text" />
                    <TextBlock Grid.Column="1" Classes="phoneValue" Text="{Binding FontSizeText}" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Margin="0,10,0,0">
                    <Button Classes="phoneBarText" Content="A" FontSize="14" Foreground="{DynamicResource Brush.Ink.Primary}"
                            Command="{Binding StepFontSizeCommand}" ToolTip.Tip="Smaller text" >
                        <Button.CommandParameter><x:Int32>-1</x:Int32></Button.CommandParameter>
                    </Button>
                    <Slider Grid.Column="1" Classes="phone" Minimum="{Binding MinFontSize}" Maximum="{Binding MaxFontSize}"
                            Value="{Binding ArticleFontSize}" TickFrequency="1" IsSnapToTickEnabled="True" />
                    <Button Grid.Column="2" Classes="phoneBarText" Content="A" FontSize="22" Foreground="{DynamicResource Brush.Ink.Primary}"
                            Command="{Binding StepFontSizeCommand}" ToolTip.Tip="Larger text" >
                        <Button.CommandParameter><x:Int32>1</x:Int32></Button.CommandParameter>
                    </Button>
                </Grid>
                <Border Classes="phoneSegments">
                    <ItemsControl ItemsSource="{Binding Fonts}" ItemTemplate="{StaticResource Segment}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>
                <Border Classes="phoneSegments">
                    <ItemsControl ItemsSource="{Binding Appearances}" ItemTemplate="{StaticResource Segment}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </Border>
    </Panel>
</ContentPage>
