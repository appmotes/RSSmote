<p:PhonePage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="urn:RSSmote.App.Controls"
             xmlns:vm="using:RSSmote.App.ViewModels"
             xmlns:p="using:RSSmote.Mobile.Pages"
             x:Class="RSSmote.Mobile.Pages.ImportFeedsPage"
             x:DataType="vm:ImportFeedsViewModel"
             Title="Import Feeds" BackTitle="Settings">
    <!-- Import Feeds (M10, D27): a file, what it adds folder by folder, what is skipped; nothing is saved before Import. -->
    <ScrollViewer>
        <StackPanel Margin="0,0,0,24">
            <TextBlock Classes="phoneIntro"
                       Text="Bring in the feeds you follow in another reader. Export them there as an OPML file, then choose it here." />
            <Button Classes="phonePrimary" Content="Choose File…" Command="{Binding ChooseCommand}" IsVisible="{Binding !HasFile}" />
            <StackPanel IsVisible="{Binding HasFile}">
                <TextBlock Classes="phoneGroup" Text="File" Margin="28,18,28,6" />
                <Border Classes="phoneCard">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinHeight="60" Margin="16,0,8,0">
                        <c:Icon Classes="lead" Size="22" Data="{StaticResource Icon.FileText}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Classes="phoneRow" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="phoneSubtitle" Text="{Binding FileSummary}" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="phoneBarText phoneGroupAction" Content="Change" Command="{Binding ChooseCommand}" />
                    </Grid>
                </Border>
                <TextBlock Classes="phoneFootnote error" Text="{Binding Error}" IsVisible="{Binding HasError}" />
                <StackPanel IsVisible="{Binding !HasError}">
                    <TextBlock Classes="phoneGroup" Text="Will be added" Margin="28,18,28,6" IsVisible="{Binding HasNew}" />
                    <Border Classes="phoneCard" IsVisible="{Binding HasNew}">
                        <ItemsControl Classes="phoneRows" ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ImportGroup">
                                    <Border Classes="phoneRowLine">
                                        <Grid Classes="phoneSwitchRow" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Panel>
                                                <c:Icon Classes="lead" Data="{StaticResource Icon.Folder}" IsVisible="{Binding IsFolder}" />
                                                <c:Icon Classes="lead" Data="{StaticResource Icon.Rss}" IsVisible="{Binding !IsFolder}" />
                                            </Panel>
                                            <TextBlock Grid.Column="1" Classes="phoneRow" Text="{Binding Title}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Classes="phoneValue" Text="{Binding CountText}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <TextBlock Classes="phoneFootnote" Text="{Binding SkippedText}" />
                    <Button Classes="phonePrimary" Content="{Binding ImportTitle}" Command="{Binding ImportCommand}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</p:PhonePage>
