<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="urn:RSSmote.App.Controls"
             xmlns:v="using:RSSmote.Mobile.Views"
             x:Class="RSSmote.Mobile.Shell.RootPage"
             AutomaticallyApplySafeAreaPadding="False"
             Padding="{Binding $self.SafeAreaPadding, Converter={x:Static v:PhoneConverters.TopInset}}"
             Background="{DynamicResource Brush.Bg.Sidebar}"
             NavigationPage.HasNavigationBar="False">
    <!-- The tab bar belongs to this page, so a pushed page has none (D23). -->
    <ContentPage.BottomCommandBar>
        <Border Padding="{Binding $parent[ContentPage].SafeAreaPadding, Converter={x:Static v:PhoneConverters.BottomInset}}"
                Background="{DynamicResource Brush.Bg.Sidebar}"
                BorderBrush="{DynamicResource Brush.Line.Separator}"
                BorderThickness="0,1,0,0">
            <UniformGrid Columns="2" Rows="1" Margin="60,0" Height="{StaticResource Size.Phone.BottomBar}">
                <Button x:Name="FeedsTab" Classes="tab" Click="OnFeedsClick">
                    <StackPanel>
                        <c:Icon Data="{StaticResource Icon.Rss}" Size="{StaticResource Size.Phone.Icon}" />
                        <TextBlock Text="Feeds" />
                    </StackPanel>
                </Button>
                <Button x:Name="SettingsTab" Classes="tab" Click="OnSettingsClick">
                    <StackPanel>
                        <c:Icon Data="{StaticResource Icon.Settings}" Size="{StaticResource Size.Phone.Icon}" />
                        <TextBlock Text="Settings" />
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Border>
    </ContentPage.BottomCommandBar>
</ContentPage>
