<!-- Fjord palette (dark slot): arctic blue-grey with an ice-blue accent. Generated from one table so every palette answers the same
     keys in the same order (D4, D5, D22). Read with DynamicResource. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color.Bg.Sidebar">#FF242933</Color> <!-- Sidebar and the window canvas between the cards -->
    <Color x:Key="Color.Bg.List">#FF2E3440</Color> <!-- Article list card -->
    <Color x:Key="Color.Bg.Article">#FF313745</Color> <!-- Article card and the article page -->
    <Color x:Key="Color.Bg.Panel">#FF3B4252</Color> <!-- Overlay panels, sidebar badges, active filter segment -->
    <Color x:Key="Color.Bg.PanelRow">#FF434C5E</Color> <!-- Fields, row groups and chips in panels -->
    <Color x:Key="Color.Bg.Pill">#FF3B4252</Color> <!-- Filter box, segment track, list badge, kbd, secondary buttons -->
    <Color x:Key="Color.Bg.Hover">#14FFFFFF</Color> <!-- Pointer-over wash on icon buttons, rows and chips -->
    <Color x:Key="Color.Bg.FaviconTile">#FF4C566A</Color> <!-- Letter tile when a feed has no favicon -->
    <Color x:Key="Color.Selection.Sidebar">#FF3B4252</Color> <!-- Selected sidebar row (raised) -->
    <Color x:Key="Color.Selection.List">#FF36475A</Color> <!-- Selected article, selected result, selected text -->
    <Color x:Key="Color.Ink.Primary">#FFECEFF4</Color> <!-- Titles, body -->
    <Color x:Key="Color.Ink.Sidebar">#FFE5E9F0</Color> <!-- Sidebar labels -->
    <Color x:Key="Color.Ink.Secondary">#FFB0B8C6</Color> <!-- Feed names, times, summaries, labels, status -->
    <Color x:Key="Color.Ink.Read">#FF9DA6B6</Color> <!-- Read article titles -->
    <Color x:Key="Color.Ink.Icon">#FFD8DEE9</Color> <!-- Chrome icons -->
    <Color x:Key="Color.Ink.OnTile">#FFFFFFFF</Color> <!-- Letter on the favicon tile -->
    <Color x:Key="Color.Accent">#FF88C0D0</Color> <!-- Selected badge, active segment, links, star, focus ring, primary button (D2) -->
    <Color x:Key="Color.Line.Separator">#1AFFFFFF</Color> <!-- Hairlines in strips and status bars, field edges -->
    <Color x:Key="Color.Scrim">#99181C24</Color> <!-- Behind every overlay panel -->
    <Color x:Key="Color.Ink.OnAccent">#FF1C2530</Color> <!-- Text and icons on an accent fill -->
    <Color x:Key="Color.Ink.Danger">#FFF0AAB0</Color> <!-- Remove Feed, Delete Folder -->
    <Color x:Key="Color.Bg.Knob">#FFFFFFFF</Color> <!-- Switch knob, on the accent and off -->

    <SolidColorBrush x:Key="Brush.Bg.Sidebar" Color="{StaticResource Color.Bg.Sidebar}" />
    <SolidColorBrush x:Key="Brush.Bg.List" Color="{StaticResource Color.Bg.List}" />
    <SolidColorBrush x:Key="Brush.Bg.Article" Color="{StaticResource Color.Bg.Article}" />
    <SolidColorBrush x:Key="Brush.Bg.Panel" Color="{StaticResource Color.Bg.Panel}" />
    <SolidColorBrush x:Key="Brush.Bg.PanelRow" Color="{StaticResource Color.Bg.PanelRow}" />
    <SolidColorBrush x:Key="Brush.Bg.Pill" Color="{StaticResource Color.Bg.Pill}" />
    <SolidColorBrush x:Key="Brush.Bg.Hover" Color="{StaticResource Color.Bg.Hover}" />
    <SolidColorBrush x:Key="Brush.Bg.FaviconTile" Color="{StaticResource Color.Bg.FaviconTile}" />
    <SolidColorBrush x:Key="Brush.Selection.Sidebar" Color="{StaticResource Color.Selection.Sidebar}" />
    <SolidColorBrush x:Key="Brush.Selection.List" Color="{StaticResource Color.Selection.List}" />
    <SolidColorBrush x:Key="Brush.Ink.Primary" Color="{StaticResource Color.Ink.Primary}" />
    <SolidColorBrush x:Key="Brush.Ink.Sidebar" Color="{StaticResource Color.Ink.Sidebar}" />
    <SolidColorBrush x:Key="Brush.Ink.Secondary" Color="{StaticResource Color.Ink.Secondary}" />
    <SolidColorBrush x:Key="Brush.Ink.Read" Color="{StaticResource Color.Ink.Read}" />
    <SolidColorBrush x:Key="Brush.Ink.Icon" Color="{StaticResource Color.Ink.Icon}" />
    <SolidColorBrush x:Key="Brush.Ink.OnTile" Color="{StaticResource Color.Ink.OnTile}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Line.Separator" Color="{StaticResource Color.Line.Separator}" />
    <SolidColorBrush x:Key="Brush.Scrim" Color="{StaticResource Color.Scrim}" />
    <SolidColorBrush x:Key="Brush.Ink.OnAccent" Color="{StaticResource Color.Ink.OnAccent}" />
    <SolidColorBrush x:Key="Brush.Ink.Danger" Color="{StaticResource Color.Ink.Danger}" />
    <SolidColorBrush x:Key="Brush.Bg.Knob" Color="{StaticResource Color.Bg.Knob}" />

    <!-- Elevation: a soft shadow, or a ring where a shadow would not read (D20) -->
    <BoxShadows x:Key="BoxShadows.Card">0 1 2 0 #66101318, 0 10 28 -12 #66101318</BoxShadows> <!-- Article list and article cards -->
    <BoxShadows x:Key="BoxShadows.Raised">0 1 2 0 #66101318, 0 0 0 1 #1AFFFFFF</BoxShadows> <!-- Selected sidebar row, active filter segment -->
    <BoxShadows x:Key="BoxShadows.Panel">0 24 64 -16 #66101318, 0 0 0 1 #1AFFFFFF</BoxShadows> <!-- Overlay panels -->

    <!-- Fluent keys mapped onto the palette so stock controls match: Dark1–3 are the accent × 0.88 / 0.76 / 0.64,
         Light1–3 the accent blended 15 / 30 / 45 % towards white -->
    <Color x:Key="SystemAccentColor">#FF88C0D0</Color>
    <Color x:Key="SystemAccentColorDark1">#FF78A9B7</Color>
    <Color x:Key="SystemAccentColorDark2">#FF67929E</Color>
    <Color x:Key="SystemAccentColorDark3">#FF577B85</Color>
    <Color x:Key="SystemAccentColorLight1">#FF9AC9D7</Color>
    <Color x:Key="SystemAccentColorLight2">#FFACD3DE</Color>
    <Color x:Key="SystemAccentColorLight3">#FFBEDCE5</Color>
</ResourceDictionary>
