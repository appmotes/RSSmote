<!-- Overlay panel pages (A6, D9): header, body and footer, and the rows inside groups. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="urn:RSSmote.App.Controls">
    <!-- Hairline above every row but the first. -->
    <Style Selector="c|PanelGroup > c|PanelRow:nth-child(n+2)">
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line.Separator}" />
    </Style>
    <!-- Rows from ItemsSource sit in ContentPresenter containers (L5). -->
    <Style Selector="c|PanelGroup ContentPresenter:nth-child(n+2) > c|PanelRow">
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line.Separator}" />
    </Style>

    <!-- Header: back (optional), title, close; the subtitle sits under it. -->
    <Style Selector="Grid.sheetHeader">
        <Setter Property="Margin" Value="20,14,10,0" />
        <Setter Property="ColumnSpacing" Value="6" />
    </Style>
    <Style Selector="Grid.sheetHeader.back">
        <Setter Property="Margin" Value="10,14,10,0" />
    </Style>
    <Style Selector="Grid.sheetHeader > TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.sheetSubtitle">
        <Setter Property="FontSize" Value="{StaticResource TextTheme.ItemSummary.Size}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink.Secondary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Margin" Value="20,2,20,0" />
    </Style>
    <Style Selector="TextBlock.sheetSubtitle.back">
        <Setter Property="Margin" Value="48,2,20,0" />
    </Style>

    <!-- Body and footer. -->
    <Style Selector="StackPanel.sheetBody">
        <Setter Property="Margin" Value="20,16,20,4" />
        <Setter Property="Spacing" Value="14" />
    </Style>
    <Style Selector="DockPanel.sheetFooter">
        <Setter Property="Margin" Value="20,16,16,16" />
    </Style>
    <Style Selector="DockPanel.sheetFooter > StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- A label beside a field in an edit panel. -->
    <Style Selector="TextBlock.formLabel">
        <Setter Property="Width" Value="{StaticResource Size.FormLabel.Width}" />
        <Setter Property="FontSize" Value="{StaticResource TextTheme.ItemSummary.Size}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink.Secondary}" />
        <Setter Property="Margin" Value="0,10,0,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <!-- Help and error text under a field. -->
    <Style Selector="TextBlock.hint">
        <Setter Property="FontSize" Value="{StaticResource TextTheme.ItemSummary.Size}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="{StaticResource Double.ItemLineHeight}" />
    </Style>
    <Style Selector="TextBlock.hint.error">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink.Danger}" />
    </Style>
</Styles>
