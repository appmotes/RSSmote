<!-- Sidebar and article list (D10, D18): virtualizing ListBoxes whose items draw an inset, rounded selection. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="urn:RSSmote.App.Controls">
    <Style Selector="ListBox.sidebar, ListBox.articles">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="ListBox.sidebar > ListBoxItem, ListBox.articles > ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.sidebar > ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Margin" Value="{StaticResource Thickness.SidebarRow.Inset}" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Row.Sidebar}" />
    </Style>
    <Style Selector="ListBox.articles > ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Margin" Value="{StaticResource Thickness.Row.Inset}" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Row.List}" />
    </Style>

    <!-- Rows wash on hover; date headers do not. -->
    <Style Selector="ListBox.sidebar > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Hover}" />
    </Style>
    <Style Selector="ListBox.articles > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Hover}" />
    </Style>
    <Style Selector="ListBox.articles > ListBoxItem.header:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.sidebar > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.sidebar > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.sidebar > ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.sidebar > ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Selection.Sidebar}" />
        <Setter Property="BoxShadow" Value="{DynamicResource BoxShadows.Raised}" />
    </Style>
    <Style Selector="ListBox.articles > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.articles > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.articles > ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.articles > ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Selection.List}" />
    </Style>
    <!-- The selected sidebar row raises, and its count badge takes the accent (D2, D20). -->
    <Style Selector="ListBox.sidebar > ListBoxItem:selected c|SidebarRow /template/ Border#PART_Badge">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector="ListBox.sidebar > ListBoxItem:selected c|SidebarRow /template/ TextBlock#PART_Count">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink.OnAccent}" />
    </Style>

    <!-- Non-selectable rows (date headers, sections) -->
    <Style Selector="ListBoxItem.header">
        <Setter Property="IsHitTestVisible" Value="True" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <!-- Cards on the canvas (D20). Two borders: the outer casts the shadow, the inner clips to the corners (L12). -->
    <Style Selector="Border.card">
        <Setter Property="Margin" Value="{StaticResource Thickness.Card.Margin}" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Card}" />
        <Setter Property="BoxShadow" Value="{DynamicResource BoxShadows.Card}" />
    </Style>
    <Style Selector="Border.cardClip">
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Card}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- Column splitters: a wide, invisible grab area on the column edge. -->
    <Style Selector="GridSplitter.column">
        <Setter Property="Width" Value="5" />
        <Setter Property="Margin" Value="-2,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ZIndex" Value="1" />
        <Setter Property="ResizeDirection" Value="Columns" />
    </Style>
    <!-- Between the two cards the grab area sits in the 8 px gap, left of the article card. -->
    <Style Selector="GridSplitter.column.gap">
        <Setter Property="Margin" Value="-6,0,-1,0" />
    </Style>
</Styles>
