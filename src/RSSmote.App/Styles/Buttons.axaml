<!-- Chrome buttons: borderless symbol buttons on the column colour (D1). Content is a controls:Icon. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{StaticResource Thickness.IconButton.Padding}" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.IconButton}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink.Icon}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.Bg.Hover}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink.Icon}" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.Bg.Hover}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink.Icon}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink.Icon}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
    </Style>

    <!-- Segments of the FilterBar: 28 × 22 icons; the selected one is raised with an accent icon. -->
    <Style Selector="Button.filter-segment">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="22" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Badge}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink.Secondary}" />
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.Bg.Hover}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink.Primary}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
    </Style>
    <Style Selector="Button.filter-segment.selected /template/ ContentPresenter#PART_ContentPresenter,
                     Button.filter-segment.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.filter-segment.selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Panel}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BoxShadow" Value="{DynamicResource BoxShadows.Raised}" />
    </Style>

    <!-- Panel buttons (D9, D21): 30 tall; primary on the accent, secondary on the pill, danger as ink. -->
    <Style Selector="Button.primary, Button.secondary, Button.danger, Button.dangerSecondary">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Field}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Style Selector="^:pressed">
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </Style>
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink.OnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter, ^:pressed /template/ ContentPresenter#PART_ContentPresenter, ^:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink.OnAccent}" />
        </Style>
    </Style>
    <Style Selector="Button.secondary, Button.dangerSecondary">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Pill}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink.Primary}" />
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter, ^:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.Bg.PanelRow}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink.Primary}" />
        </Style>
    </Style>
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink.Danger}" />
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter, ^:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.Bg.Hover}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink.Danger}" />
        </Style>
    </Style>
    <Style Selector="Button.dangerSecondary">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink.Danger}" />
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter, ^:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink.Danger}" />
        </Style>
    </Style>
    <!-- The key a button answers to, after its label: "esc", "↵". -->
    <Style Selector="Button TextBlock.keyHint">
        <Setter Property="FontSize" Value="{StaticResource TextTheme.Kbd.Size}" />
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A folder chip (D9): one choice of several; the chosen one takes the accent. -->
    <Style Selector="Button.chip">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Chip}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line.Separator}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.PanelRow}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink.Primary}" />
        <Setter Property="FontSize" Value="{StaticResource TextTheme.ItemSummary.Size}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.Bg.Pill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line.Separator}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink.Primary}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
    </Style>
    <Style Selector="Button.chip.on /template/ ContentPresenter#PART_ContentPresenter,
                     Button.chip.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink.OnAccent}" />
    </Style>

    <!-- Phone tab bar (D23): icon over label, the selected tab in the accent. Content is a StackPanel. -->
    <Style Selector="Button.tab">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,6,0,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="FontSize" Value="{StaticResource TextTheme.Count.Size}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink.Secondary}" />
        <Style Selector="^ StackPanel">
            <Setter Property="Spacing" Value="3" />
        </Style>
        <Style Selector="^ StackPanel > :is(Control)">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter, ^:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink.Secondary}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
    </Style>
    <Style Selector="Button.tab.selected">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.tab.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.tab.selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>
</Styles>
