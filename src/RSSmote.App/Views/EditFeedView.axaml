<!-- Edit Feed panel (A6): name and folder. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="urn:RSSmote.App.Controls"
             xmlns:vm="using:RSSmote.App.ViewModels"
             xmlns:v="using:RSSmote.App.Views"
             x:Class="RSSmote.App.Views.EditFeedView"
             x:DataType="vm:EditFeedViewModel">
    <c:PanelFrame>
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <Grid Classes="sheetHeader" ColumnDefinitions="*,Auto">
                    <TextBlock Classes="largeTitle" Text="{Binding Title}" />
                    <Button Grid.Column="1" Classes="icon" ToolTip.Tip="Close (Esc)" Command="{Binding CloseCommand}">
                        <c:Icon Data="{StaticResource Icon.X}" />
                    </Button>
                </Grid>
                <TextBlock Classes="sheetSubtitle" Text="{Binding Subtitle}" />
            </StackPanel>
            <DockPanel DockPanel.Dock="Bottom" Classes="sheetFooter">
                <StackPanel>
                    <Button Classes="secondary" Command="{Binding CloseCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock Text="Cancel" VerticalAlignment="Center" />
                            <TextBlock Classes="keyHint" Text="esc" />
                        </StackPanel>
                    </Button>
                    <Button Classes="primary" Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock Text="Save" VerticalAlignment="Center" />
                            <TextBlock Classes="keyHint" Text="↵" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="20,16,20,4" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="14">
                    <TextBlock Classes="formLabel" Text="Name" />
                    <TextBox x:Name="NameBox" Grid.Column="1" Classes="panel-field" Text="{Binding Name}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding SaveCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <TextBlock Grid.Row="1" Classes="formLabel" Text="Folder" />
                    <v:FolderPickerView Grid.Row="1" Grid.Column="1" DataContext="{Binding Picker}" />
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </c:PanelFrame>
</UserControl>
