<!-- A new-folder field and the folders as chips (FolderPickerViewModel). Clicking the chosen chip again chooses none. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="urn:RSSmote.App.Controls"
             xmlns:vm="using:RSSmote.App.ViewModels"
             x:Class="RSSmote.App.Views.FolderPickerView"
             x:DataType="vm:FolderPickerViewModel">
    <StackPanel Spacing="10">
        <TextBox x:Name="FolderBox" Classes="panel-field" PlaceholderText="New folder name"
                 Text="{Binding NewFolderName}">
            <TextBox.InnerLeftContent>
                <c:Icon Data="{StaticResource Icon.Plus}" Size="14" Margin="0,0,8,0"
                        Foreground="{DynamicResource Brush.Ink.Secondary}" />
            </TextBox.InnerLeftContent>
            <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding AddFolderCommand}" />
            </TextBox.KeyBindings>
        </TextBox>
        <ItemsControl ItemsSource="{Binding Folders}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel ItemSpacing="6" LineSpacing="6" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FolderChoiceViewModel">
                    <Button Classes="chip" Classes.on="{Binding IsOn}" Content="{Binding Folder.Title}"
                            Command="{Binding $parent[UserControl].((vm:FolderPickerViewModel)DataContext).ToggleCommand}"
                            CommandParameter="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
