<!-- The three columns (A5): sidebar · article list · article, resizable with splitters. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="urn:RSSmote.App.Controls"
             xmlns:vm="using:RSSmote.App.ViewModels"
             xmlns:v="using:RSSmote.App.Views"
             x:Class="RSSmote.App.Views.ShellView"
             x:DataType="vm:ShellViewModel">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource GridLength.Column.Sidebar}"
                              MinWidth="{StaticResource Size.Column.SidebarMin}"
                              MaxWidth="{StaticResource Size.Column.SidebarMax}" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="{StaticResource GridLength.Column.List}"
                              MinWidth="{StaticResource Size.Column.ListMin}"
                              MaxWidth="{StaticResource Size.Column.ListMax}" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="{StaticResource Size.Column.ArticleMin}" />
        </Grid.ColumnDefinitions>

        <v:SidebarView Grid.Column="0" />
        <GridSplitter Grid.Column="1" Classes="column" />
        <v:ArticleListView Grid.Column="2" />
        <GridSplitter Grid.Column="3" Classes="column gap" />
        <v:ArticleView Grid.Column="4" />

        <!-- The canvas above the cards drags the window like the strips do (D20). -->
        <Border Grid.Column="2" Grid.ColumnSpan="3" Height="8" VerticalAlignment="Top" Background="Transparent"
                WindowDecorationProperties.ElementRole="TitleBar" />

        <!-- Centred in the window; the article hides its native web view meanwhile (L9). -->
        <ContentControl Grid.Column="0" Grid.ColumnSpan="5" Content="{Binding Panel}"
                        IsVisible="{Binding IsPanelOpen}" c:PanelFrame.DismissRequested="OnPanelDismissRequested">
            <ContentControl.DataTemplates>
                <DataTemplate x:DataType="vm:AddFeedViewModel">
                    <v:AddFeedView />
                </DataTemplate>
                <DataTemplate x:DataType="vm:EditFeedViewModel">
                    <v:EditFeedView />
                </DataTemplate>
                <DataTemplate x:DataType="vm:EditFolderViewModel">
                    <v:EditFolderView />
                </DataTemplate>
                <DataTemplate x:DataType="vm:ConfirmViewModel">
                    <v:ConfirmView />
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>
    </Grid>
</UserControl>
