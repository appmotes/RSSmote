<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="urn:RSSmote.App.Controls">
    <ControlTheme x:Key="{x:Type c:PanelGroup}" TargetType="c:PanelGroup">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.PanelRow}" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Group}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource Brush.Line.Separator}" BorderThickness="1"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True">
                    <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
