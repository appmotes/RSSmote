<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="urn:RSSmote.App.Controls">
    <ControlTheme x:Key="{x:Type c:PanelRow}" TargetType="c:PanelRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink.Primary}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Height" Value="{StaticResource Size.PanelRow.Height}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="{StaticResource TextTheme.PanelRow.Size}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        BorderBrush="{TemplateBinding BorderBrush}">
                    <Grid ColumnDefinitions="*,Auto" Margin="{TemplateBinding Padding}">
                        <StackPanel x:Name="PART_Text" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock Text="{TemplateBinding Title}" FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="PART_Subtitle" Text="{TemplateBinding Subtitle}" IsVisible="False"
                                       FontSize="{StaticResource TextTheme.PanelRowSubtitle.Size}"
                                       Foreground="{DynamicResource Brush.Ink.Secondary}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <c:Icon x:Name="PART_Chevron" Grid.Column="1" IsVisible="False" Size="13"
                                Data="{StaticResource Icon.ChevronRight}"
                                Foreground="{DynamicResource Brush.Ink.Secondary}" />
                        <Border x:Name="PART_Check" Grid.Column="1" IsVisible="False" Width="18" Height="18"
                                CornerRadius="9" BorderThickness="1.5" BorderBrush="{DynamicResource Brush.Ink.Read}">
                            <c:Icon x:Name="PART_CheckIcon" Data="{StaticResource Icon.Check}" Size="11" StrokeThickness="2.2"
                                    IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Foreground="{DynamicResource Brush.Ink.OnAccent}" />
                        </Border>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.Bg.Hover}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="^:centered /template/ StackPanel#PART_Text">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="^:subtitle">
            <Setter Property="Height" Value="{StaticResource Size.PanelRowTall.Height}" />
        </Style>
        <Style Selector="^:subtitle /template/ TextBlock#PART_Subtitle">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:chevron /template/ c|Icon#PART_Chevron">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:check /template/ Border#PART_Check">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:check:on">
            <Setter Property="Background" Value="{DynamicResource Brush.Selection.List}" />
        </Style>
        <Style Selector="^:check:on /template/ Border#PART_Check">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        </Style>
        <Style Selector="^:check:on /template/ c|Icon#PART_CheckIcon">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
